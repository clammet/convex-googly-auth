{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>yuzuyuzuyu/repo-automation:public#v1.0.0"
  ],
  "packageRules": [
    {
      "description": "Supply-chain soak: automerged PRs rebase onto main first so CI ran against the current base",
      "groupName": "Routine updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "prConcurrentLimit": 1,
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Attempt major updates automatically after a week; CI must pass before merge",
      "groupName": "Major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "dependencyDashboardApproval": false
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:action-digest-review#v1.0.0"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:renovate-engine#v1.0.0"
      ]
    },
    {
      "description": "Generate release notes and a package version bump for npm dependency updates",
      "matchManagers": [
        "npm"
      ],
      "postUpgradeTasks": {
        "commands": [
          "node scripts/create-renovate-changeset.mjs"
        ],
        "dataFileTemplate": "{{{ toJSON upgrades }}}",
        "executionMode": "branch"
      }
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:node-runtime#v1.0.0"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:age-3-days#v1.0.0"
      ]
    },
    {
      "extends": [
        "github>yuzuyuzuyu/repo-automation:age-7-days#v1.0.0"
      ]
    }
  ]
}
